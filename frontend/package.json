    "@popperjs/core": "^2.11.8",
    "@tabler/icons-webfont": "^3.36.0",
    "bootstrap": "^5.3.8",
    "glightbox": "^3.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
