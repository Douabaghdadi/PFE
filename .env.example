# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# En production, déclarer les mêmes variables dans l'hébergeur.

# MongoDB (local par défaut ; en production : URI MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/test
MONGODB_DATABASE=test

# JWT (chaîne aléatoire longue, au moins 64 caractères)
JWT_SECRET=

# Email (Gmail : utiliser un "mot de passe d'application")
MAIL_USERNAME=
MAIL_PASSWORD=

# Gemini
GEMINI_API_KEY=

# URL publique du frontend, sans "/" final
FRONTEND_URL=http://localhost:4200
# Origines autorisées (CORS), séparées par des virgules, sans espace
CORS_ALLOWED_ORIGINS=http://localhost:4200
